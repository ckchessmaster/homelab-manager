{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ControlPlane": {
    "HubUrl": "",
    "AgentBinarySync": {
      "Repository": "ckchessmaster/homelab-manager",
      "Enabled": true,
      "CheckOnStartup": true,
      "SyncIntervalHours": 6
    }
  },
  "Temporal": {
    "Enabled": true,
    "Address": "localhost:7233",
    "ServerUrl": "localhost:7233",
    "Namespace": "homelab-manager",
    "TaskQueue": "homelab-manager-tasks",
    "Auth": {
      "Enabled": false,
      "TokenUrl": "https://auth.chriskingdon.com/oauth/v2/token",
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": "openid"
    }
  },
  "Oidc": {
    "Authority": "",
    "ClientId": "controlplane",
    "Audience": "controlplane",
    "DisplayName": "Single Sign-On",
    "RoleClaimType": "groups",
    "NameClaimType": "preferred_username",
    "Scope": "openid profile email groups",
    "RequireHttpsMetadata": true,
    "Roles": {
      "Admin": [ "admin", "authentik Admins" ],
      "Operator": [ "operator" ],
      "Viewer": [ "viewer" ]
    }
  }
}